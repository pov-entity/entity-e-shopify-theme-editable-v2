<section class="entity-home">
  <div class="entity-wrap entity-home-inner">
    <p class="entity-kicker">ENTITY-E.com</p>
    <h1>One company. Every step.</h1>
    <p>From product request to secure checkout, order tracking, and customer support — ENTITY-E.com keeps the buying path clear.</p>
    <div class="entity-actions">
      <a class="entity-btn entity-btn-primary" href="/collections/all">Shop products</a>
      <a class="entity-btn entity-btn-secondary" href="/pages/request-product">Request a product</a>
    </div>
  </div>
</section>

<style>
.entity-home{min-height:76vh;display:grid;place-items:center;background:linear-gradient(180deg,#fff 0%,#f8f5ee 100%);padding:70px 0}.entity-home-inner{text-align:center;max-width:820px}.entity-kicker{font-size:12px;font-weight:950;letter-spacing:.14em;text-transform:uppercase;color:#071946}.entity-home h1{font-size:clamp(44px,7vw,82px);line-height:.95;letter-spacing:-.05em;margin:0 0 18px;color:#071946}.entity-home p{font-size:clamp(17px,2vw,22px);line-height:1.55;color:#667086}.entity-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:28px}@media(max-width:640px){.entity-btn{width:100%}}
</style>

