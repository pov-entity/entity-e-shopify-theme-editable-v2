<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <title>{{ page_title | default: shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% if template.suffix == 'product-landing' %}
      {{ 'ndl-optimization.css' | asset_url | stylesheet_tag }}
    {% endif %}
  </head>
  <body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
